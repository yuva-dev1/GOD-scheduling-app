# Cloud Run server (server/index.js)
PORT=8080

# Deployed Apps Script Web App URL that reads/writes the Scheduling spreadsheet.
# Typically https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec
APPS_SCRIPT_URL="https://script.google.com/macros/s/XXX/exec"

# Shared secret merged into every request the server forwards to Apps Script.
# Apps Script rejects any request whose token does not match (the "WAF" check).
APPS_SCRIPT_TOKEN="replace-with-a-long-random-secret"

# Secret used to sign session tokens issued at login (must match the value
# configured as TOKEN_SIGNING_SECRET in the Apps Script project).
TOKEN_SIGNING_SECRET="replace-with-a-long-random-secret"

# Comma-separated browser origins allowed to call this API, or "*".
CORS_ORIGINS="http://localhost:6100"

# Frontend (Vite) — base path for API calls. Local dev proxies /api to the
# server above (see vite.config.ts), so this is normally left as /api.
VITE_API_BASE_URL="/api"
